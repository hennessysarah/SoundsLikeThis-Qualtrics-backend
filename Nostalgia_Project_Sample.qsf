 space) that <b>makes you feel nostalgic</b>, then click&nbsp;&nbsp;<button style=\"font-size:20px;width:70px;height:50px\" type=\"button\">HERE</button>&nbsp;&nbsp;to see if it's in Spotify's system. (You will have the opportunity to enter more songs later. For now just enter one song.)<div><br></div><div><i>For example, to select \"<b>My Song\" </b>by<b>&nbsp;My Artist</b>, you would type: <b>My Song My Artist</b></i></div>", "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function()\n{\n\t/* ================= SETTINGS: edit these for your study ================= */\n\n\t// The SoundsLikeThis server (no need to change)\n\tvar SERVER_URL = 'https://soundslikethis-webapp.onrender.com/api/qualtrics/match';\n\n\t// How closely matched songs must fit the participant's song\n\tvar ENERGY_RANGE   = 0.15;  // max difference in energy (arousal)\n\tvar VALENCE_RANGE  = 0.15;  // max difference in valence\n\tvar MIN_POPULARITY = 80;    // minimum Spotify popularity (0-100) for matched songs\n\tvar MAX_YEAR_DIFF  = 5;     // matched songs must be released within this many years\n\tvar NUM_RECS       = 10;    // how many matched songs to save (rec11 ... rec19, rec110)\n\t                            // (if you change this, add matching embedded data fields in the Survey Flow)\n\n\t// Messages shown to participants\n\tvar MSG_FOUND     = function(name, artists) { return 'The song found on Spotify is ' + name + ' by ' + artists + '.'; };\n\tvar MSG_CONFIRM   = 'You may proceed by clicking the red arrow if this artist and title is correct';\n\tvar MSG_NOT_FOUND = 'We did not find enough information about this song to proceed. Please choose another song instead.';\n\tvar MSG_ERROR     = 'Something went wrong. Please wait a moment and click the button again.';\n\n\t/* ======================================================================== */\n\n\tvar question = this;\n\tquestion.disableNextButton();\n\n\t// Keep only recommendations released within MAX_YEAR_DIFF years of the seed song\n\tfunction filterByYear(recs, seedYear) {\n\t\tvar kept = [];\n\t\tfor (var i = 0; i < recs.length; i++) {\n\t\t\tif (recs[i].release_year && Math.abs(recs[i].release_year - seedYear) < MAX_YEAR_DIFF) {\n\t\t\t\tkept.push(recs[i]);\n\t\t\t}\n\t\t}\n\t\treturn kept;\n\t}\n\n\t// Save every audio feature as embedded data, e.g. song1_danceability, rec11_tempo\n\tfunction saveFeatures(prefix, features) {\n\t\tfor (var name in features) {\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix + '_' + name, features[name]);\n\t\t}\n\t}\n\n\t// Save matched songs as embedded data: rec11, rec12, ... rec19, rec110,\n\t// plus each one's name, artists, popularity, release year and audio features\n\tfunction saveRecs(recs, seedId) {\n\t\tvar chosen = recs.slice(0, NUM_RECS);\n\t\tvar ids = [];\n\t\tfor (var i = 0; i < chosen.length; i++) {\n\t\t\tvar field = 'rec1' + (i + 1);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(field, 'https://open.spotify.com/embed/track/' + chosen[i].id);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(field + '_name', chosen[i].name);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(field + '_artists', chosen[i].artists);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(field + '_popularity', chosen[i].popularity);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(field + '_release_year', chosen[i].release_year);\n\t\t\tif (chosen[i].features) { saveFeatures(field, chosen[i].features); }\n\t\t\tids.push(chosen[i].id);\n\t\t}\n\t\tQualtrics.SurveyEngine.setEmbeddedData('recarray1', ids.slice(0, 4));\n\t\tQualtrics.SurveyEngine.setEmbeddedData('shortUri1', 'https://open.spotify.com/embed/track/' + seedId);\n\t}\n\n\tquestion.questionclick = function(event, element)\n\t{\n\t\tif (element.type != 'button') { return; }\n\n\t\tquestion.disableNextButton();\n\n\t\t// Clean up the participant's text\n\t\tvar input = jQuery('input[type=text]')[0].value;\n\t\tinput = input.replace(',', '').replace(':', '').replace(' by ', ' ').replace(/\"/g, '');\n\n\t\tjQuery.ajax({\n\t\t\turl: SERVER_URL,\n\t\t\ttype: 'POST',\n\t\t\tcontentType: 'application/json',\n\t\t\ttimeout: 90000, // the server may take up to a minute to wake up\n\t\t\tdata: JSON.stringify({\n\t\t\t\tquery: input,\n\t\t\t\tenergy_range: ENERGY_RANGE,\n\t\t\t\tvalence_range: VALENCE_RANGE,\n\t\t\t\tmin_popularity: MIN_POPULARITY,\n\t\t\t\tlimit: 50\n\t\t\t}),\n\t\t\tsuccess: function(data) {\n\t\t\t\tif (!data.found || !data.features) {\n\t\t\t\t\talert(MSG_NOT_FOUND);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\n\t\t\t\tvar seed = data.track;\n\t\t\t\talert(MSG_FOUND(seed.name, seed.artists));\n\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('shortUri1', seed.id);\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('pop1', seed.popularity);\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('rel_date1', seed.release_year);\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('arousal1', data.features.energy);\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('valence1', data.features.valence);\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('song1_name', seed.name);\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData('song1_artists', seed.artists);\n\t\t\t\tsaveFeatures('song1', data.features);\n\n\t\t\t\t// Prefer songs matched on energy/valence/popularity; otherwise fall back\n\t\t\t\t// to Spotify's plain recommendations (same as the original block)\n\t\t\t\tvar matched = filterByYear(data.recs_matched, seed.release_year);\n\t\t\t\tvar plain = filterByYear(data.recs_plain, seed.release_year);\n\n\t\t\t\tif (matched.length >= NUM_RECS) {\n\t\t\t\t\tsaveRecs(matched, seed.id);\n\t\t\t\t} else if (plain.length >= NUM_RECS) {\n\t\t\t\t\tsaveRecs(plain, seed.id);\n\t\t\t\t} else {\n\t\t\t\t\talert(MSG_NOT_FOUND);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\n\t\t\t\talert(MSG_CONFIRM);\n\t\t\t\tquestion.enableNextButton();\n\t\t\t},\n\t\t\terror: function() {\n\t\t\t\talert(MSG_ERROR);\n\t\t\t}\n\t\t});\n\t};\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n});\n\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\n});\n", "DefaultChoices": false, "DataExportTag": "Q167", "QuestionID": "QID167", "QuestionType": "TE", "Selector": "SL", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "Put in ONE song and artist (separated by space) that makes you feel nostalgic, then click\u00a0\u00a0HERE\u00a0\u00a0...", "Validation": {"Settings": {"ForceResponse": "OFF", "ForceResponseType": "ON", "Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "SearchSource": {"AllowFreeResponse": "false"}}}, {"SurveyID": "SV_9SnS1kawzDopVRk", "Element": "SQ", "PrimaryAttribute": "QID195", "SecondaryAttribute": "You will now be asked to enter one song that make you feel nostalgic. Nostalgia is defined here a...", "TertiaryAttribute": null, "Payload": {"QuestionText": "You will now be asked to enter one song that make you feel <b>nostalgic</b>. Nostalgia is defined here as <i>a&nbsp;sentimental longing for the past</i>. This should be a song that<b> brings you back</b> to a pleasant moment or era of your life and evokes a strong <b>memory</b>. You may look at your phone, computer, or streaming service to find the name and artists of songs that may make you feel nostalgic!&nbsp;", "DefaultChoices": false, "DataExportTag": "Q195", "QuestionID": "QID195", "QuestionType": "DB", "Selector": "TB", "Configuration": {"QuestionDescriptionOption": "UseText"}, "QuestionDescription": "You will now be asked to enter one song that make you feel nostalgic. Nostalgia is defined here a...", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "GradingData": [], "Language": [], "NextChoiceId": 4, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}}}, {"SurveyID": "SV_9SnS1kawzDopVRk", "Element": "SQ", "PrimaryAttribute": "QID214", "SecondaryAttribute": "Please listen. The song may take a few seconds to load. Once the clip has finished playing 30 sec..